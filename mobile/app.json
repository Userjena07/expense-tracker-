{
  "expo": {
    "name": "ExpenseTracker",
    "slug": "expense-tracker",
    "scheme": "expensetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8FAFC",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.expensetracker.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-updates",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ExpenseTracker to use Face ID for biometric authentication."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1302a854-1b97-4b2e-b3a3-214c60ae591e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1302a854-1b97-4b2e-b3a3-214c60ae591e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 4000
    }
  }
}
